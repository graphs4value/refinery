import builtin::view.

class Node {
  @show
  Node[] shown

  @hide
  Node[] hidden

  @show(true)
  Node[] onlyTrue
}

Node(a).
Node(b).
Node(c).

shown(a, b).
hidden(a, b).
onlyTrue(a, b).
