  "name": "@tools.refinery/electron",
  "version": "0.0.0",
  "description": "Refinery Desktop application",
  "private": true,
  "main": "index.cjs",
  "scripts": {
    "build": "yarn run build:ts && yarn run build:electron",
    "build:ci": "CI=true yarn run build",
    "build:ts": "MODE=production yarn run bundle",
    "build:electron": "MODE=production yarn run electron-builder --project . --config electron-builder.config.mjs",
    "bundle": "node esbuild.mjs",
    "backend:extract": "node scripts/extractBackend.mjs",
    "zig:install": "node scripts/installZig.mjs",
    "launcher:build": "node scripts/buildLauncher.mjs",
    "dev": "MODE=development yarn run bundle && electron build/esbuild/development/index.cjs",
    "typecheck": "yarn run g:tsc -p subprojects/electron/tsconfig.json",
    "test": "vitest",
    "test:run": "yarn run test --run --coverage",
    "test:run:ci": "CI=true yarn run test:run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:ci": "CI=true yarn run test:e2e",
    "test:e2e:update": "REFINERY_UPDATE_SNAPSHOTS=1 yarn run test:e2e --update",
    "lint": "yarn run g:lint subprojects/electron",
    "lint:fix": "yarn run lint --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graphs4value/refinery.git"
  },
  "author": "The Refinery Authors <https://refinery.tools/>",
  "license": "EPL-2.0",
  "bugs": {
    "url": "https://github.com/graphs4value/refinery/issues"
  },
  "homepage": "https://refinery.tools",
  "dependencies": {
    "@alloc/tree-kill": "^1.4.0",
    "lodash-es": "^4.18.1",
    "mobx": "^6.16.1",
    "ms": "^2.1.3",
    "nanoid": "^6.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@types/d3-color": "^3.1.3",
    "@types/lodash-es": "^4.17.12",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@types/yauzl": "^3",
    "@types/yazl": "^3",
    "@vitest/coverage-istanbul": "^4.1.10",
    "cheerio": "^1.2.0",
    "d3-color": "^3.1.0",
    "date-fns": "^4.4.0",
    "dmg-builder": "26.15.7",
    "electron": "43.4.0",
    "electron-builder": "26.15.7",
    "electron-builder-squirrel-windows": "26.15.7",
    "esbuild": "^0.28.1",
    "java-properties": "^1.0.2",
    "pdfjs-dist": "5.4.296",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "tar": "^7.5.20",
    "vitest": "^4.1.10",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
